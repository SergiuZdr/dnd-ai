{"nodes": [{"id": "game_saves_test_envelope_and_version_guard", "label": "Saves are {schemaVersion,data} envelopes with an atomic write", "file_type": "code", "source_file": "test/game/saves.test.ts", "source_location": "L84-L150", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No .tmp files survive a save, exactly four files are written, updatedAt is refreshed, and a tampered schemaVersion throws an error naming the file and both versions."}, {"id": "game_saves_test_v1_to_v2_migration", "label": "v1 saves gain luck:1 and empty background fields without clobbering", "file_type": "code", "source_file": "test/game/saves.test.ts", "source_location": "L152-L257", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pre-luck save must load and keep everything else untouched; if the fields somehow already exist they are preserved; a genuinely newer-than-supported version still throws rather than being silently migrated. Re-saving persists the current SCHEMA_VERSION."}, {"id": "game_saves_test_v2_to_v3_migration", "label": "v2 worlds gain Quest.reward defaulted to empty string", "file_type": "code", "source_file": "test/game/saves.test.ts", "source_location": "L259-L335", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same shape as the v1->v2 migration: default the new field, never clobber an existing one, tolerate an empty quests array, and persist v3 on re-save."}, {"id": "game_saves_test_slug_containment", "label": "A campaign slug that resolves outside its save dir is refused", "file_type": "code", "source_file": "test/game/saves.test.ts", "source_location": "L457-L500", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-player isolation works by scoping baseDir to the player's own folder, so an escaping slug escapes the isolation. path.join normalises '../alice/secret' straight into a sibling player's campaign; this was verified exploitable before the guard existed. deleteCampaign is protected by the same check."}, {"id": "game_saves_test_listing_degrades_on_corrupt_hero", "label": "A corrupt or missing hero file degrades the card, not the listing", "file_type": "code", "source_file": "test/game/saves.test.ts", "source_location": "L337-L410", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The campaign must stay in the picker and stay resumable; listings sort newest-updated first and tolerate stray files and empty directories."}, {"id": "game_saves_test_transcript_skips_corrupt_lines", "label": "Transcript reading skips corrupt JSONL lines and keeps valid ones", "file_type": "code", "source_file": "test/game/saves.test.ts", "source_location": "L412-L454", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A half-written line from a crash must not make the whole campaign history unreadable; a missing file reads as an empty array."}, {"id": "game_saves_test_delete_is_recoverable", "label": "deleteCampaign retires into .deleted rather than destroying", "file_type": "code", "source_file": "test/game/saves.test.ts", "source_location": "L501-L510", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "game_saves_test_envelope_and_version_guard", "target": "game_saves_savegame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "test/game/saves.test.ts", "source_location": "L7", "weight": 1.0}, {"source": "game_saves_test_envelope_and_version_guard", "target": "game_saves_loadgame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "test/game/saves.test.ts", "source_location": "L8", "weight": 1.0}, {"source": "game_saves_test_v1_to_v2_migration", "target": "game_saves_loadgame", "relation": "references", "confidence": "EXTRACTED"