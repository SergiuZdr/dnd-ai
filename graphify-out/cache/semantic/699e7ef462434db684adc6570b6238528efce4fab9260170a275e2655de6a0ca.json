{"nodes": [{"id": "game_newcampaign_test_race_id_or_name", "label": "Race resolves from a preset ID as well as a display name", "file_type": "code", "source_file": "test/game/newCampaign.test.ts", "source_location": "L133-L185,L243-L288", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The web wizard renders race cards from /api/presets and posts back the preset ID, not the display name. Matching on name alone silently zeroed every web-created character's racial bonuses and stored race as 'elf', which rendered as 'elf Rogue' in the HUD and went to the DM that way. canonicalRaceName must also pass an unrecognized string through unchanged so old saves and custom races survive a round trip."}, {"id": "game_newcampaign_test_explicit_stats_verbatim", "label": "An explicit stats map is honored verbatim, not re-sorted by class priority", "file_type": "code", "source_file": "test/game/newCampaign.test.ts", "source_location": "L290-L308", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The web wizard's manual assignment must survive; racial bonuses land on top of it rather than replacing it."}, {"id": "game_newcampaign_test_derived_stat_clamps", "label": "maxHp floors at 1 and the AC dex bonus clamps to [0,+2]", "file_type": "code", "source_file": "test/game/newCampaign.test.ts", "source_location": "L310-L360", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Degenerate stat pools must not produce a 0-HP or AC-penalized character."}, {"id": "game_newcampaign_test_slug_collision_and_no_write", "label": "Campaign slugs collide into -2/-3 and creation writes nothing to disk", "file_type": "code", "source_file": "test/game/newCampaign.test.ts", "source_location": "L399-L459", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creation is pure: it also copies starter items rather than sharing preset array/object references, so mutating a new character cannot poison the presets for the next one."}, {"id": "game_newcampaign_test_newhero_preserves_world", "label": "createNewHero keeps campaign/world/chronicle and rebuilds only the character", "file_type": "code", "source_file": "test/game/newCampaign.test.ts", "source_location": "L567-L676", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identity-equal references to the three preserved sections, a character computed exactly as createNewCampaign would for the same class/race/stats, and no mutation of the existing state."}], "edges": [{"source": "game_newcampaign_test_race_id_or_name", "target": "game_newcampaign_applyracebonuses", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "test/game/newCampaign.test.ts", "source_location": "L12", "weight": 1.0}, {"source": "game_newcampaign_test_race_id_or_name", "target": "game_newcampaign_findrace", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "test/game/newCampaign.test.ts", "source_location": "L13", "weight": 1.0}, {"source": "game_newcampaign_test_race_id_or_name", "target": "game_newcampaign_canonicalracename", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "test/game/newCampaign.test.ts", "source_location": "L14", "weight": 1.0}, {"source": "game_newcampaign_test_race_id_or_name", "target": "game_newcampaign_createnewcampaign", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "test/game/newCampaign.test.ts", "source_location": "L16", "weight": 1.0}, {"source": "game_newcampaign_applyracebonuses", "target": "game_newcampaign_findrace", "relation": "calls", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "test/game/newCampaign.test.ts", "source_location": "L154-L161", "weight": 1.0}, {"source": "game_newcampaign_createnewcampaign", "target