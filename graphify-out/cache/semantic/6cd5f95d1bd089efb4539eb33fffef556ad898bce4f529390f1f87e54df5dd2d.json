{"nodes": [{"id": "ai_argrepair_test_unwraps_json_schema_wrapper", "label": "Repair unwraps JSON-Schema-shaped {type,value} args", "file_type": "code", "source_file": "test/ai/argRepair.test.ts", "source_location": "L51-L87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The PR-7 spike observed small models emitting {\"type\":\"integer\",\"value\":15} for a plain dc, for strings as well as numbers. Unwrapping it in the repair layer keeps a valid tool call instead of a rejected one."}, {"id": "ai_argrepair_test_coerces_numeric_string", "label": "Numeric string coerced to number, non-numeric string is not", "file_type": "code", "source_file": "test/ai/argRepair.test.ts", "source_location": "L66-L74,L147-L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repair must be narrow: '25' -> 25 is safe, 'a lot' -> NaN would silently corrupt the ledger, so it stays unrepairable."}, {"id": "ai_argrepair_test_drops_unknown_keys", "label": "Hallucinated extra keys are dropped, call stays valid", "file_type": "code", "source_file": "test/ai/argRepair.test.ts", "source_location": "L89-L97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Models add fields like `confidence`; rejecting the whole call for them would cost a turn."}, {"id": "ai_argrepair_test_never_throws", "label": "Unrepairable args return ok:false, never throw", "file_type": "code", "source_file": "test/ai/argRepair.test.ts", "source_location": "L109-L145", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A throw kills the turn; an {ok:false,error} lets the caller hand the model an `ERROR: ...` tool result so it self-corrects. Covers missing required fields, bad enum values, and non-object arguments (bare string, array, null)."}], "edges": [{"source": "ai_argrepair_test_unwraps_json_schema_wrapper", "target": "ai_argrepair_repairandvalidateargs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "test/ai/argRepair.test.ts", "source_location": "L12", "weight": 1.0}, {"source": "ai_argrepair_test_coerces_numeric_string", "target": "ai_argrepair_repairandvalidateargs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "test/ai/argRepair.test.ts", "source_location": "L12", "weight": 1.0}, {"source": "ai_argrepair_test_drops_unknown_keys", "target": "ai_argrepair_repairandvalidateargs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "test/ai/argRepair.test.ts", "source_location": "L12", "weight": 1.0}, {"source": "ai_argrepair_test_never_throws", "target": "ai_argrepair_repairandvalidateargs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "test/ai/argRepair.test.ts", "source_location": "L12", "weight": 1.0}, {"source": "ai_argrepair_test_never_throws", "target": "ai_tools_createdmtools", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "test/ai/argRepair.test.ts", "source_location": "L11", "weight": 1.0}, {"source": "ai_argrepair_repairandvalidateargs", "target": "ai_tools_createdmtools", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "test/ai/argRepair.test.ts", "source_location": "L53-L56", "weight": 1.0}], "hyperedges": []}